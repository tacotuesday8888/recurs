  "reference": {
    "source": "export function diffSnapshots(previous,current) {\n const previousNames=new Set(Object.keys(previous)),currentNames=new Set(Object.keys(current));\n return {changed:[...currentNames].filter(name=>!previousNames.has(name)||previous[name]!==current[name]).sort(),removed:[...previousNames].filter(name=>!currentNames.has(name)).sort()};\n}\nexport function affectedModules(graph,changed) {\n const known=new Set(Object.keys(graph)),reverse=new Map();\n for(const name of known)for(const dependency of graph[name]){if(!reverse.has(dependency))reverse.set(dependency,new Set());reverse.get(dependency).add(name);}\n const found=new Set(changed.filter(name=>known.has(name))),queue=[...found];\n for(let i=0;i<queue.length;i++)for(const importer of reverse.get(queue[i])??[]){if(!found.has(importer)){found.add(importer);queue.push(importer);}}\n return [...found].sort();\n}\nexport function planBuild(graph,previous,current) {\n const delta=diffSnapshots(previous,current),currentNames=new Set(Object.keys(current));\n return {...delta,build:affectedModules(graph,[...delta.changed,...delta.removed]).filter(name=>currentNames.has(name))};\n}\n",
    "sha256": "dda57d46733c78b49ade5ca9b6ea157abe3d3eb109dd58f9b88c78123ae4273e"
